# MT5 bridge URL — server-side only, never exposed to browser
# On Vercel: add this as an Environment Variable (not NEXT_PUBLIC_)
MT5_BASE_URL=https://your-mt5-bridge-url

# ── Backtest runner (/backtest page → /api/backtest) ─────────────────────────
# The runner shells out to the `backtest` binary in the repo root, which reads
# Alpaca keys from the repo-root .env (see scripts/setup-keys.sh). You can also
# enter keys directly in the UI per-run.
#
# Optional: path to a prebuilt binary to avoid `cargo run` on every request,
# e.g. BACKTEST_BIN=../target/release/backtest
# BACKTEST_BIN=
